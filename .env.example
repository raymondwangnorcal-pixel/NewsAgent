OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
BRIEFING_COMPRESSION=true

BRIEFING_DELIVERY_CHANNEL=telegram

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: comma-separated list for individual delivery to multiple chats.
# If set, TELEGRAM_CHAT_IDS is used instead of TELEGRAM_CHAT_ID.
TELEGRAM_CHAT_IDS=

# Temporary Gmail-only parity mode needs the SMTP variables below. Native email
# Watchlist delivery also requires both market-data keys.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
# Required by native Watchlist runs for the SEC EDGAR User-Agent. Use the
# dedicated NewsAgent contact address; it is never printed in diagnostics.
SEC_CONTACT_EMAIL=
TIINGO_API_KEY=
EODHD_API_KEY=
# Set false to keep Watchlist processing active while omitting it from email output.
NEWSLETTER_SHOW_WATCHLIST=true

# Phase 4 SMS, not required for Phase 1
BRIEFING_TO_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

BRIEFING_LOOKBACK_HOURS=30
BRIEFING_MAX_ARTICLES=240
BRIEFING_TIMEZONE=America/New_York
BRIEFING_MEGA_CAP_TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL
BRIEFING_CA_BUNDLE=
BRIEFING_MAX_CHARS_PER_MESSAGE_SMS=1400
BRIEFING_MAX_STORIES_PER_CATEGORY_SMS=5
BRIEFING_MAX_SOURCES_PER_STORY=3
BRIEFING_INCLUDE_LINKS_SMS=false
BRIEFING_INCLUDE_LINKS_TELEGRAM=false
